# Required on Vercel (Project Settings -> Environment Variables)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_your_publishable_key
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-medusa-backend.example.com
MEDUSA_BACKEND_URL=https://your-medusa-backend.example.com

# Optional storefront settings
NEXT_PUBLIC_DEFAULT_REGION=in
NEXT_PUBLIC_SHOP_NAME=Dilwale Bags
NEXT_PUBLIC_SHOP_DESCRIPTION=Dilwale Bags Store
# Set to your canonical production URL (falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL)
# NEXT_PUBLIC_BASE_URL=https://dilwale-bags.vercel.app

